#!/usr/bin/env bash
#
# 构建飞书 AI 问答网关的 Docker 镜像。
#
# 用法:
#   ./scripts/build_docker                  # 构建 + tag latest
#   ./scripts/build_docker --no-cache       # 不使用构建缓存
#   ./scripts/build_docker --push           # 构建后推送到镜像仓库
#
set -euo pipefail
export DOCKER_BUILDKIT=1

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
IMAGE_NAME="${FEISHU_BOT_IMAGE:-welink-feishu-bot}"
CONTEXT_DIR="$REPO_DIR/feishu-bot"

cd "$REPO_DIR"

# ── 解析参数 ──────────────────────────────────────────────────────────────────
NO_CACHE=false
PUSH=false
for arg in "$@"; do
  case "$arg" in
    --no-cache)  NO_CACHE=true ;;
    --push)      PUSH=true ;;
    *) echo "未知参数: $arg"; exit 1 ;;
  esac
done

# ── 获取 git 信息 ─────────────────────────────────────────────────────────────
SHA=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  构建飞书网关 Docker 镜像"
echo "  镜像名: $IMAGE_NAME"
echo "  commit: $SHA"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

BUILD_ARGS="--network=host -f $CONTEXT_DIR/Dockerfile -t $IMAGE_NAME:$SHA -t $IMAGE_NAME:latest"

if [ "$NO_CACHE" = true ]; then
  BUILD_ARGS="$BUILD_ARGS --no-cache"
fi

echo ""
echo "📦 构建镜像 $IMAGE_NAME:$SHA ..."
echo ""
docker build $BUILD_ARGS "$CONTEXT_DIR"

echo ""
echo "✅ 镜像构建完成: $IMAGE_NAME:$SHA"

# ── 可选: 推送 ────────────────────────────────────────────────────────────────
if [ "$PUSH" = true ]; then
  echo ""
  echo "📤 推送镜像..."
  docker push "$IMAGE_NAME:$SHA"
  docker push "$IMAGE_NAME:latest"
  echo "✅ 推送完成"
fi

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  ✅ 完成!"
echo "  镜像: $IMAGE_NAME:$SHA  ($IMAGE_NAME:latest)"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
